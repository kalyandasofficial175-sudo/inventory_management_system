# Database - Use a PostgreSQL connection string from Supabase or Neon
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/inventory?schema=public"

# NextAuth - Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET="Admin_143 Inventory_App_Secret"

# NextAuth URL - your app URL
NEXTAUTH_URL="http://localhost:3000"

# Email (Gmail example — use an App Password, not your main password)
EMAIL_FROM="your-email@gmail.com"
EMAIL_SERVER_HOST="smtp.gmail.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="your-email@gmail.com"
EMAIL_SERVER_PASSWORD="your-app-password"
